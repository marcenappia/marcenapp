VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Production auth callback is fixed in application code: https://www.marcenapp.com.br/auth

# Server-side Supabase Edge Function secrets; never expose these as VITE_* values.
# MARCENARIA_MAGICA_RENDER_URL=https://<deployment-da-marcenaria-magica>/api/marcenaria-render
# MARCENARIA_MAGICA_RENDER_SECRET=<shared-secret-for-server-to-server-render>
# MARCENARIA_MAGICA_RENDER_MODEL=marcenaria-magica-render-v1

# WhatsApp Cloud API — configure via `supabase secrets set`, never in VITE_*.
# WHATSAPP_VERIFY_TOKEN=<webhook-verification-secret>
# WHATSAPP_ACCESS_TOKEN=<permanent-system-user-token>
# WHATSAPP_GRAPH_VERSION=v23.0
