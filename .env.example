VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Production auth callback is fixed in application code: https://www.marcenapp.com.br/auth

# Server-side Supabase Edge Function secrets; never expose these as VITE_* values.
# The Marcenaria Mágica render engine runs natively inside the ai-image Edge Function
# (gateway /v1/images/edits, model openai/gpt-image-2.5-sunburst) and uses the existing
# LOVABLE_API_KEY. It requires no MARCENARIA_MAGICA_* variable and no external service.
# LOVABLE_API_KEY=<gateway-key-already-used-by-ai-image>

# WhatsApp Cloud API — configure via `supabase secrets set`, never in VITE_*.
# WHATSAPP_VERIFY_TOKEN=<webhook-verification-secret>
# WHATSAPP_ACCESS_TOKEN=<permanent-system-user-token>
# WHATSAPP_GRAPH_VERSION=v23.0
